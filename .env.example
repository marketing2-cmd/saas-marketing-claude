# Supabase — chaves públicas, usadas pelo @supabase/ssr no navegador e no servidor
# (login/signup, middleware de sessão, leitura do próprio profile). Seguras para
# expor ao navegador — RLS decide o que cada usuário autenticado pode acessar.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Supabase — usadas apenas no servidor (rotas /api/*), nunca expostas ao navegador.
# Mesma URL do projeto acima; a service role key ignora RLS por completo.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque-aqui-a-service-role-key

# Anthropic (usada pela rota /api/ai/suggest-demand para classificar demandas)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Resend (usada pela rota /api/auth/notify-signup para avisar o admin por e-mail
# a cada novo cadastro pendente). Crie uma conta gratuita em resend.com.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Opcional — remetente do e-mail. Sem domínio verificado no Resend, use o
# endereço de sandbox abaixo (só entrega para o e-mail da própria conta Resend).
RESEND_FROM_EMAIL=Marketing OS <onboarding@resend.dev>
