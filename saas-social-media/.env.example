# ── Supabase ──────────────────────────────────────────────────
# Project Settings → API. A publishable key é segura no navegador (RLS protege).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# Só no servidor (portal do cliente, cron, OAuth). Ignora RLS — nunca exponha.
SUPABASE_SERVICE_ROLE_KEY=coloque-aqui-a-service-role-key

# URL pública do app (sem barra no final). Usada no redirect do login da Meta.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Agendador ────────────────────────────────────────────────
# Segredo que protege /api/cron/publish. A Vercel envia automaticamente
# "Authorization: Bearer $CRON_SECRET" nas chamadas do cron.
CRON_SECRET=gere-um-valor-aleatorio-longo

# ── Meta (Instagram) ─────────────────────────────────────────
# developers.facebook.com → Meus apps → seu app → Configurações → Básico
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
